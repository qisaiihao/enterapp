<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. 项目基本信息 (您可以根据自己的情况修改) -->
    <groupId>com.yourcompany</groupId>
    <artifactId>scf-justauth-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!-- 2. 项目属性配置, 这里指定了使用 Java 11 和 UTF-8 编码 -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <!-- 统一管理依赖版本 -->
        <justauth.version>1.16.6</justauth.version>
        <scf.events.version>0.0.2</scf.events.version>
        <logback.version>1.2.11</logback.version>
    </properties>

    <!-- 3. 项目所需的核心依赖 -->
    <dependencies>
        <!-- JustAuth 核心库 -->
        <dependency>
            <groupId>me.zhyd.oauth</groupId>
            <artifactId>JustAuth</artifactId>
            <version>${justauth.version}</version>
        </dependency>

        <!-- 腾讯云云函数 (SCF) 的 Java 事件处理依赖 -->
        <dependency>
            <groupId>com.tencentcloudapi</groupId>
            <artifactId>scf-java-events</artifactId>
            <version>${scf.events.version}</version>
        </dependency>

        <!-- 日志门面 SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
        </dependency>

        <!-- Logback 作为日志的具体实现，云函数环境推荐 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${logback.version}</version>
        </dependency>
    </dependencies>

    <!-- 4. 构建配置 -->
    <build>
        <plugins>
            <!-- 这是最关键的插件，用于将所有依赖打入最终的 jar 包 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>