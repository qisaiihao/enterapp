{
	"compilerOptions": {
		// 不编译 JS 文件，只做类型检查
		"allowJs": false,
		"skipLibCheck": true,
		// 允许隐式 any，避免过于严格的类型检查
		"noImplicitAny": false,
		// 模块和目标配置，适合 uni-app
		"target": "es2019",
		"module": "esnext",
		"moduleResolution": "node",
		"lib": ["es2019", "dom"],
		"jsx": "preserve",
		"baseUrl": ".",
		"paths": {}
	},
	"vueCompilerOptions": {
		"globalTypesPath": "./.vscode/vue-global-types.d.ts"
	},
	"include": [
		"**/*.ts",
		"**/*.d.ts",
		"**/*.vue"
	],
	"exclude": [
		"node_modules",
		"unpackage",
		"dist",
		"**/*.js",
		"uni_modules/uni-upgrade-center-app/**/*"
	]
}


